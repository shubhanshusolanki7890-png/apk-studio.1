#!/usr/bin/env sh
#
# Gradle start up script for POSIX generated for APK STUDIO Android Template
# Resolves system `gradle` binary or `gradle-wrapper.jar` when present.
#

APP_HOME=$( cd "${0%/*}" && pwd -P ) || exit
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

if [ -f "$WRAPPER_JAR" ]; then
    exec "$JAVACMD" -Xmx64m -Xms64m -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
elif command -v gradle >/dev/null 2>&1; then
    exec gradle -p "$APP_HOME" "$@"
else
    echo "ERROR: Neither gradle-wrapper.jar nor a system 'gradle' installation was found." >&2
    echo "Install Gradle 8.5+ or run 'gradle wrapper' in build-engine/android-template." >&2
    exit 127
fi
